+        # A compile_cmd.json next to compile.sh may give the compiler argv directly:
+        # {"argv": [...]}; the permuter appends "-c SOURCE -o OUTPUT". This avoids a shell
+        # per candidate and needs no bash, which matters most on Windows.
+        self._argv = _direct_argv(compile_cmd)
+        if self._argv is not None:
+            self._bash = ""
+            return
+
         bash = shutil.which("bash")
         if bash is None:
             raise Exception(
                 "No `bash` executable was found on PATH. Install bash and make "
-                "sure it's on PATH (on Windows, Git for Windows provides one)."
+                "sure it's on PATH (on Windows, Git for Windows provides one), "
+                "or provide a compile_cmd.json with a direct compiler argv."
             )
         self._bash = bash
 
