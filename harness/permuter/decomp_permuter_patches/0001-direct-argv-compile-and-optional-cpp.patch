@@ -6,6 +8,20 @@ import shutil
 from .helpers import try_remove
 
 
+def _direct_argv(compile_cmd: str) -> Optional[List[str]]:
+    path = os.path.join(os.path.dirname(os.path.abspath(compile_cmd)), "compile_cmd.json")
+    if not os.path.isfile(path):
+        return None
+    with open(path, encoding="utf-8") as f:
+        value = json.load(f)
+    argv = value.get("argv") if isinstance(value, dict) else None
+    if value.get("supported") is False or not isinstance(argv, list) or not argv:
+        return None
+    if not all(isinstance(part, str) for part in argv):
+        raise Exception(f"{path}: argv must be a list of strings")
+    return argv
+
+
 class Compiler:
