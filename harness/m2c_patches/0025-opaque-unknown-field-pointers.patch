diff --git a/tests/unit/test_unknown_pointer_decls.py b/tests/unit/test_unknown_pointer_decls.py
index 3f315da..e3a722f 100644
--- a/tests/unit/test_unknown_pointer_decls.py
+++ b/tests/unit/test_unknown_pointer_decls.py
@@ -25,6 +25,15 @@ class TestUnknownPointerDecls(unittest.TestCase):
     def test_unknown_values_are_not_replaced_with_void(self):
         self.assertEqual(Type.any().format(Formatter(valid_syntax=True)), "M2C_UNK")
 
+    def test_unsized_unknown_field_pointees_use_opaque_pointers(self):
+        target = Type.any_field()
+        before = repr(target)
+        self.assertEqual(Type.ptr(target).format(Formatter(valid_syntax=True)), "void *")
+        self.assertEqual(Type.ptr(Type.ptr(target)).format(Formatter(valid_syntax=True)), "void **")
+        self.assertEqual(target.format(Formatter(valid_syntax=True)), "M2C_UNK")
+        self.assertEqual(Type.ptr(target).format(Formatter()), "? *")
+        self.assertEqual(repr(target), before)
+
     def test_silent_register_casts_keep_required_integer_pointer_conversions(self):
         pointer = Type.ptr(Type.s32())
         to_pointer = Cast(GlobalSymbol("address", Type.s32()), pointer, reinterpret=True, silent=True)
