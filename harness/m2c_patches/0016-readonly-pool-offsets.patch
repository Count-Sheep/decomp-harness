index 0000000..9f0db5d
--- /dev/null
+++ b/tests/unit/test_readonly_constants.py
@@ -0,0 +1,54 @@
+from pathlib import Path
+import tempfile
+import unittest
+
+from m2c.asm_file import AsmDataEntry, AsmSymbolicData
+from m2c.asm_instruction import AsmGlobalSymbol
+from m2c.main import parse_flags
+from run_tests import decompile_and_capture_output
+
+
+class TestReadonlyConstants(unittest.TestCase):
+    def translate(self, instructions, data, context="float test(void);", section=".sdata2"):
+        with tempfile.TemporaryDirectory() as name:
+            root = Path(name)
+            (root / "target.s").write_text(
+                ".text\n.fn test, global\n" + instructions + "\nblr\n.endfn test\n"
+                + '.section ' + section + ', "a"\n.obj "@pool", local\n' + data + '\n.endobj "@pool"\n')
+            (root / "context.c").write_text(context)
+            return decompile_and_capture_output(parse_flags([
+                "-t", "ppc-mwcc-c", "--valid-syntax", "--no-cache", "--no-unk-inference",
+                "--explicit-field-access", "--context", str(root / "context.c"), str(root / "target.s")]))
+
+    def test_float_pool_offset_is_loaded_from_the_exact_bytes(self):
+        code = self.translate('lis r3,"@pool"@ha\naddi r3,r3,"@pool"@l\nlfs f1,4(r3)',
+                              '.4byte 0x3F800000\n.4byte 0x40200000')
+        self.assertIn("return 2.5f;", code)
+        self.assertNotIn("@pool", code)
+
+    def test_double_pool_offset_preserves_negative_zero(self):
+        code = self.translate('lis r3,"@pool"@ha\naddi r3,r3,"@pool"@l\nlfd f1,8(r3)',
+                              '.4byte 0x3FF00000, 0\n.4byte 0x80000000, 0', "double test(void);")
+        self.assertIn("return -0.0;", code)
+        self.assertNotIn("@pool", code)
+
+    def test_writable_data_is_not_folded(self):
+        code = self.translate('lis r3,"@pool"@ha\naddi r3,r3,"@pool"@l\nlfs f1,4(r3)',
+                              '.4byte 0x3F800000\n.4byte 0x40200000', section=".data")
+        self.assertNotIn("return 2.5f;", code)
+
+    def test_negative_and_out_of_bounds_reads_are_not_satisfied(self):
+        entry = AsmDataEntry(("test", 0), data=[bytes(range(16))])
+        self.assertIsNone(entry.data_at_offset(-8, 4))
+        self.assertIsNone(entry.data_at_offset(14, 4))
+        self.assertEqual(entry.data_at_offset(4, 4), bytes(range(4, 8)))
+
+    def test_symbolic_data_cannot_be_read_from_an_interior_offset(self):
+        symbol = AsmSymbolicData(AsmGlobalSymbol("external"), 4)
+        entry = AsmDataEntry(("test", 0), data=[symbol])
+        self.assertIsNone(entry.data_at_offset(1, 4))
+        self.assertEqual(entry.data_at_offset(0, 4), symbol)
+
+
+if __name__ == "__main__":
+    unittest.main()
