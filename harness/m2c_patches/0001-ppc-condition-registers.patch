diff --git a/tests/unit/test_ppc.py b/tests/unit/test_ppc.py
new file mode 100644
index 0000000..dfe5fd3
--- /dev/null
+++ b/tests/unit/test_ppc.py
@@ -0,0 +1,38 @@
+import unittest
+
+from m2c.arch_ppc import PpcArch
+from m2c.asm_instruction import AsmGlobalSymbol, AsmInstruction, AsmLiteral, AsmState, Register
+from m2c.instruction import InstructionMeta
+
+
+class TestPpcConditionFields(unittest.TestCase):
+    def test_symbolic_cr_bits_normalize_like_numeric_bits(self):
+        symbolic = AsmInstruction("cror", [AsmGlobalSymbol("eq"), AsmGlobalSymbol("lt"), AsmGlobalSymbol("eq")])
+        normalized = PpcArch.normalize_instruction(symbolic, AsmState())
+        self.assertEqual(normalized.args, [AsmLiteral(2), AsmLiteral(0), AsmLiteral(2)])
+        other = AsmInstruction("addi", [Register("r3"), Register("r4"), AsmGlobalSymbol("eq")])
+        self.assertEqual(PpcArch.normalize_instruction(other, AsmState()).args[-1], AsmGlobalSymbol("eq"))
+
+    def test_branch_reads_requested_field(self):
+        branch = PpcArch.parse("beq", [Register("cr1"), AsmGlobalSymbol("label")], InstructionMeta.missing())
+        self.assertEqual(branch.inputs, [Register("cr1_eq")])
+        default = PpcArch.parse("bne", [AsmGlobalSymbol("label")], InstructionMeta.missing())
+        self.assertEqual(default.inputs, [Register("cr0_eq")])
+
+    def test_compare_writes_only_requested_field(self):
+        compare = PpcArch.parse("cmpwi", [Register("cr3"), Register("r3"), AsmLiteral(0)], InstructionMeta.missing())
+        self.assertEqual(set(compare.outputs), {Register(f"cr3_{bit}") for bit in ("lt", "gt", "eq", "so")})
+
+    def test_conditional_return_reads_requested_field(self):
+        branch = PpcArch.parse("beqlr", [Register("cr2")], InstructionMeta.missing())
+        self.assertIn(Register("cr2_eq"), branch.inputs)
+        self.assertNotIn(Register("cr0_eq"), branch.inputs)
+
+    def test_condition_fields_obey_call_preservation(self):
+        self.assertIn(Register("cr1_eq"), PpcArch.temp_regs)
+        self.assertIn(Register("cr2_eq"), PpcArch.saved_regs)
+        self.assertNotIn(Register("cr2_eq"), PpcArch.temp_regs)
+
+
+if __name__ == "__main__":
+    unittest.main()
