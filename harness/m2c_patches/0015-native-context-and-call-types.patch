diff --git a/tests/unit/test_native_drafts.py b/tests/unit/test_native_drafts.py
new file mode 100644
index 0000000..f8bc448
--- /dev/null
+++ b/tests/unit/test_native_drafts.py
@@ -0,0 +1,86 @@
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+from m2c.main import parse_flags
+from run_tests import decompile_and_capture_output
+
+
+class TestNativeDrafts(unittest.TestCase):
+    def translate(self, instructions, context, declarations="used-context"):
+        with tempfile.TemporaryDirectory() as name:
+            root = Path(name)
+            (root / "target.s").write_text(".fn test, global\n" + instructions + "\n.endfn test\n")
+            (root / "context.c").write_text(context)
+            flags = ["-t", "ppc-mwcc-c", "--valid-syntax", "--no-cache", "--no-unk-inference",
+                     "--explicit-field-access", "--globals", declarations,
+                     "--context", str(root / "context.c"), str(root / "target.s")]
+            return decompile_and_capture_output(parse_flags(flags))
+
+    def test_context_declarations_are_reachable_only_and_preserve_return_evidence(self):
+        code = self.translate("b lookup", "int test(void); int lookup(); float unused(void);")
+        self.assertIn("int lookup(", code)
+        self.assertNotIn("unused", code)
+        self.assertIn("return lookup(", code)
+        self.assertNotIn("CRASHED", code)
+
+    def test_context_globals_are_declarations_not_duplicate_initializers(self):
+        code = self.translate("lis r3,value@ha\nlwz r3,value@l(r3)\nblr",
+                              "int value = 3; int unused = 7;")
+        self.assertIn("extern int value;", code)
+        self.assertNotIn("= 3", code)
+        self.assertNotIn("unused", code)
+
+    def test_existing_declaration_modes_keep_their_contract(self):
+        for mode in ("used", "none"):
+            code = self.translate("b lookup", "int lookup();", mode)
+            self.assertNotIn("s32 lookup(", code)
+
+    def test_known_typed_prototype_and_array_declaration_survive_generation(self):
+        code = self.translate("lis r3,bytes@ha\naddi r3,r3,bytes@l\nb lookup",
+                              "unsigned char bytes[16]; int lookup(unsigned char *);")
+        self.assertIn("int lookup(unsigned char *);", code)
+        self.assertIn("extern unsigned char bytes[16];", code)
+        self.assertIn("lookup(bytes)", code)
+
+    def test_inferred_integer_call_parameters_retain_register_class(self):
+        code = self.translate("li r3,1\nli r4,2\nb lookup",
+                              "int test(void); int lookup();")
+        self.assertIn("int lookup(s32, s32);", code)
+        self.assertNotIn("M2C_UNK", code)
+
+    def test_inferred_float_call_parameter_does_not_become_integer(self):
+        code = self.translate("li r3,1\nfmr f1,f2\nb lookup",
+                              "int test(float a, float b); int lookup();")
+        self.assertIn("int lookup(s32, f32);", code)
+        self.assertNotIn("M2C_UNK", code)
+
+    def test_context_qualifiers_and_complete_void_parameter_lists_are_preserved(self):
+        code = self.translate("lis r3,value@ha\nlwz r3,value@l(r3)\nb lookup",
+                              "extern volatile const int value; const char *lookup(int);")
+        self.assertIn("extern volatile const int value;", code)
+        self.assertIn("const char *lookup(int);", code)
+        noargs = self.translate("b lookup", "int test(void); int lookup(void);")
+        self.assertIn("int lookup(void);", noargs)
+
+    def test_incomplete_return_pointer_retains_const_when_parameters_are_inferred(self):
+        code = self.translate("li r3,1\nb lookup", "const char *test(void); const char *lookup();")
+        self.assertIn("const char *lookup(s32);", code)
+
+    @unittest.skipUnless(shutil.which("clang"), "Clang required for raw C syntax checks")
+    def test_integer_address_expression_produces_compilable_raw_load(self):
+        code = self.translate("add r3,r3,r4\nlwz r3,0(r3)\nblr",
+                              "int test(unsigned int base, unsigned int offset);")
+        with tempfile.TemporaryDirectory() as name:
+            path = Path(name) / "draft.c"
+            path.write_text("typedef int s32; typedef unsigned int u32;\n" + code)
+            run = subprocess.run([shutil.which("clang"), "-target", "powerpc-unknown-none",
+                                  "-std=c89", "-fsyntax-only", "-Werror", str(path)],
+                                 capture_output=True, text=True, timeout=30)
+            self.assertEqual(run.returncode, 0, code + run.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
