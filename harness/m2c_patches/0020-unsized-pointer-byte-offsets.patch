diff --git a/tests/unit/test_pointer_offsets.py b/tests/unit/test_pointer_offsets.py
index 37acec3..c9ea94a 100644
--- a/tests/unit/test_pointer_offsets.py
+++ b/tests/unit/test_pointer_offsets.py
@@ -6,6 +6,33 @@ from m2c.types import Type
 
 
 class TestPointerOffsets(unittest.TestCase):
+    def test_unsized_pointer_offsets_use_bytes_in_valid_syntax(self):
+        fmt = Formatter(valid_syntax=True)
+        for target in (None, Type.any(), Type.void()):
+            pointer = GlobalSymbol('cursor', Type.ptr(target))
+            for op in ('+', '-'):
+                for offset in (Literal(4), GlobalSymbol('step', Type.s32())):
+                    with self.subTest(target=target, op=op, offset=offset):
+                        expr = BinaryOp(pointer, op, offset, pointer.type)
+                        expected = f'((void *) ((char *) cursor {op} {offset.format(fmt)}))'
+                        self.assertEqual(expr.format(fmt), expected)
+                        assignment = format_assignment(pointer, expr, fmt)
+                        self.assertIn('cursor = ', assignment)
+                        self.assertNotIn(f'cursor {op}=', assignment)
+
+    def test_unsized_pointer_integer_result_and_commuted_addition(self):
+        fmt = Formatter(valid_syntax=True)
+        pointer = GlobalSymbol('cursor', Type.ptr())
+        expr = BinaryOp(Literal(4), '+', pointer, Type.s32())
+        self.assertEqual(expr.format(fmt), '((s32) ((char *) cursor + 4))')
+        self.assertEqual(expr.format(Formatter()), '(4 + cursor)')
+
+    def test_unsized_pointer_difference_is_not_an_offset(self):
+        pointer = GlobalSymbol('cursor', Type.ptr())
+        other = GlobalSymbol('end', Type.ptr())
+        expr = BinaryOp(pointer, '-', other, Type.s32())
+        self.assertIsNone(expr.pointer_offset(include_unsized=True))
+
