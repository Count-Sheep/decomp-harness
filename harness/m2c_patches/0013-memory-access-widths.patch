diff --git a/tests/unit/test_memory_widths.py b/tests/unit/test_memory_widths.py
new file mode 100644
index 0000000..27ce561
--- /dev/null
+++ b/tests/unit/test_memory_widths.py
@@ -0,0 +1,119 @@
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+from m2c.main import parse_flags
+from run_tests import decompile_and_capture_output
+
+
+class TestMemoryWidths(unittest.TestCase):
+    def translate(self, instructions, context, *, native=True):
+        with tempfile.TemporaryDirectory() as name:
+            root = Path(name)
+            (root / "target.s").write_text(".fn test, global\n" + instructions + "\nblr\n.endfn test\n")
+            (root / "context.c").write_text(context)
+            flags = ["-t", "ppc-mwcc-c", "--valid-syntax", "--no-cache", "--no-unk-inference",
+                     "--context", str(root / "context.c"), str(root / "target.s")]
+            if native:
+                flags.append("--explicit-field-access")
+            return decompile_and_capture_output(parse_flags(flags))
+
+    def test_word_load_from_byte_pointer_and_global_casts_address_not_value(self):
+        for native in (False, True):
+            pointer = self.translate("lwz r3,0(r3)", "unsigned int test(unsigned char *bytes);", native=native)
+            self.assertIn("*(u32 *) bytes", pointer)
+            self.assertNotIn("(u32) *bytes", pointer)
+            global_load = self.translate("lis r3,bytes@ha\nlwz r3,bytes@l(r3)",
+                                         "extern unsigned char bytes[]; unsigned int test(void);", native=native)
+            self.assertIn("*(u32 *) bytes", global_load)
+            self.assertNotIn("(u32) *bytes", global_load)
+
+    def test_signed_halfword_and_float_loads_preserve_instruction_type(self):
+        half = self.translate("lha r3,0(r3)", "short test(unsigned char *bytes);")
+        self.assertIn("*(s16 *) bytes", half)
+        single = self.translate("lfs f1,0(r3)", "float test(unsigned char *bytes);")
+        self.assertIn("*(f32 *) bytes", single)
+        double = self.translate("lfd f1,0(r3)", "double test(unsigned char *bytes);")
+        self.assertIn("*(f64 *) bytes", double)
+        self.assertNotIn("M2C_BITWISE", single + double)
+
+    def test_word_store_and_partial_word_store_use_memory_not_conversion(self):
+        word = self.translate("stw r4,0(r3)", "void test(unsigned char *bytes, unsigned int value);")
+        self.assertIn("*(u32 *) bytes", word)
+        byte = self.translate("stb r4,0(r3)", "void test(unsigned int *words, unsigned char value);")
+        self.assertIn("*(u8 *) words", byte)
+        self.assertNotIn("*words =", byte)
+
+    def test_matching_declarations_stay_in_their_original_source_form(self):
+        normal = self.translate("lwz r3,0(r3)", "unsigned int test(unsigned int *words);")
+        self.assertIn("return *words;", normal)
+        self.assertNotIn("(u32 *)", normal)
+        offset = self.translate("lwz r3,4(r3)", "unsigned int test(unsigned char *bytes);")
+        self.assertIn("(char *)(bytes)", offset)
+        self.assertIn("u32 *", offset)
+
+    def test_indexed_access_keeps_byte_index_and_instruction_width(self):
+        word = self.translate("lwzx r3,r3,r4", "unsigned int test(unsigned char *bytes, unsigned int offset);")
+        self.assertIn("u32 *", word)
+        self.assertNotIn("return bytes[offset]", word)
+        store = self.translate("stwx r5,r3,r4", "void test(unsigned char *bytes, unsigned int offset, unsigned int value);")
+        self.assertIn("u32 *", store)
+
+    @unittest.skipUnless(shutil.which("clang"), "Clang required for independent big-endian codegen")
+    def test_halfword_of_word_global_uses_big_endian_memory_not_numeric_truncation(self):
+        generated = self.translate("lis r3,word@ha\nlhz r3,word@l(r3)",
+                                   "extern unsigned int word; unsigned short test(void);")
+        self.assertIn("*(u16 *) &word", generated)
+        self.assertNotIn("(u16) word", generated)
+        targets = subprocess.run([shutil.which("clang"), "--print-targets"],
+                                 capture_output=True, text=True, timeout=30)
+        self.assertEqual(targets.returncode, 0, targets.stderr)
+        if "ppc32" in targets.stdout:
+            triple, instruction = "powerpc-unknown-linux-gnu", "lhz"
+        elif "armeb" in targets.stdout:
+            triple, instruction = "armeb-unknown-linux-gnueabi", "ldrh"
+        else:
+            self.skipTest("Clang has no supported big-endian backend")
+        with tempfile.TemporaryDirectory() as name:
+            source = Path(name) / "test.c"
+            source.write_text("typedef unsigned int u32; typedef unsigned short u16;\n"
+                              "extern unsigned int word;\n" + generated)
+            compiled = subprocess.run([shutil.which("clang"), "-target", triple,
+                                       "-ffreestanding", "-fno-pic", "-std=c89", "-O2", "-S",
+                                       str(source), "-o", "-"], capture_output=True, text=True, timeout=30)
+            self.assertEqual(compiled.returncode, 0, compiled.stderr)
+            self.assertRegex(compiled.stdout, r"(?m)^\s+" + instruction + r"\s")
+
+    def test_known_aggregate_member_does_not_cast_the_whole_struct(self):
+        generated = self.translate("lwz r3,0(r3)",
+                                   "struct Record { unsigned int value; unsigned int other; }; "
+                                   "unsigned int test(struct Record *record);")
+        self.assertIn("return record->value;", generated)
+        self.assertNotIn("(u32 *) record", generated)
+
+    @unittest.skipUnless(shutil.which("clang"), "Clang required for independent C execution")
+    def test_generated_word_load_store_and_partial_store_execute_at_the_right_width(self):
+        cases = [
+            ("lwz r3,0(r3)", "unsigned int test(unsigned char *bytes);",
+             "return test((unsigned char *)words) != 0x12345678U;"),
+            ("stw r4,0(r3)", "void test(unsigned char *bytes, unsigned int value);",
+             "test((unsigned char *)words, 0x89abcdefU); return words[0] != 0x89abcdefU || words[1] != 0x87654321U;"),
+            ("stb r4,0(r3)", "void test(unsigned int *words, unsigned char value);",
+             "unsigned char before[sizeof(words)]; unsigned int i; "
+             "for(i=0;i<sizeof(words);i++) before[i]=((unsigned char *)words)[i]; "
+             "test(words, 0xAB); if(((unsigned char *)words)[0]!=0xAB) return 1; "
+             "for(i=1;i<sizeof(words);i++) if(((unsigned char *)words)[i]!=before[i]) return 2; return 0;"),
+        ]
+        for instructions, context, body in cases:
+            with self.subTest(instructions=instructions), tempfile.TemporaryDirectory() as name:
+                generated = self.translate(instructions, context)
+                source = ("typedef unsigned int u32; typedef unsigned char u8;\n" + generated
+                          + "\nint main(void) { unsigned int words[2]={0x12345678U,0x87654321U}; " + body + " }\n")
+                path, executable = Path(name) / "test.c", Path(name) / "test"
+                path.write_text(source)
+                compiled = subprocess.run([shutil.which("clang"), "-std=c89", "-O2", "-Wall", "-Werror",
+                                           str(path), "-o", str(executable)], capture_output=True, text=True, timeout=30)
+                self.assertEqual(compiled.returncode, 0, compiled.stderr)
+                self.assertEqual(subprocess.run([str(executable)], timeout=10).returncode, 0)
