diff --git a/tests/unit/test_context_externs.py b/tests/unit/test_context_externs.py
new file mode 100644
index 0000000..5a49055
--- /dev/null
+++ b/tests/unit/test_context_externs.py
@@ -0,0 +1,74 @@
+from pathlib import Path
+import tempfile
+import unittest
+
+from m2c.arch_ppc import PpcArch
+from m2c.c_types import build_typemap, to_c
+
+
+class TestContextExterns(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.path = Path(temporary.name) / 'context.c'
+        self.arch = PpcArch()
+        self.path.write_text('''
+int first(void) {
+    extern long long clock_value(void);
+    extern int counter;
+    int local;
+    static int local_static;
+    { extern int nested; }
+    return 0;
+}
+int second(void) {
+    extern float clock_value(double);
+    extern float counter;
+    return 0;
+}
+''')
+
+    def test_only_selected_outer_externs_become_symbol_types(self):
+        types = build_typemap([self.path], PpcArch(), False, context_function='first')
+        self.assertEqual(to_c(types.functions['clock_value'].ret_type), 'long long')
+        self.assertEqual(types.functions['clock_value'].params, [])
+        self.assertEqual(to_c(types.var_types['counter']), 'int')
+        for name in ('local', 'local_static', 'nested'):
+            self.assertNotIn(name, types.var_types)
+
+    def test_default_context_does_not_promote_any_local_declarations(self):
+        types = build_typemap([self.path], PpcArch(), False)
+        self.assertNotIn('clock_value', types.functions)
+        self.assertNotIn('counter', types.var_types)
+
+    def test_selected_function_is_part_of_memory_and_disk_cache_identity(self):
+        first = build_typemap([self.path], self.arch, True, context_function='first')
+        second = build_typemap([self.path], self.arch, True, context_function='second')
+        self.assertNotEqual(first.source_hash, second.source_hash)
+        self.assertEqual(to_c(second.functions['clock_value'].ret_type), 'float')
+        self.assertEqual(to_c(second.var_types['counter']), 'float')
+        self.assertEqual(to_c(first.var_types['counter']), 'int')
+
+    def test_existing_global_types_take_precedence(self):
+        self.path.write_text('int counter;\n' + self.path.read_text())
+        types = build_typemap([self.path], PpcArch(), False, context_function='second')
+        self.assertEqual(to_c(types.var_types['counter']), 'int')
+
+    def test_function_private_typedefs_and_tags_are_not_guessed_as_global_types(self):
+        self.path.write_text('''
+struct Shape { int value; };
+int first(void) {
+    typedef double Local;
+    struct Shape { float value; };
+    extern Local hidden_value;
+    extern struct Shape hidden_shape;
+    return 0;
+}
+''')
+        types = build_typemap([self.path], self.arch, False, context_function='first')
+        self.assertNotIn('hidden_value', types.var_types)
+        self.assertNotIn('hidden_shape', types.var_types)
+
+
+if __name__ == '__main__':
+    unittest.main()
