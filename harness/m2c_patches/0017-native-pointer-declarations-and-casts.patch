diff --git a/tests/unit/test_unknown_pointer_decls.py b/tests/unit/test_unknown_pointer_decls.py
new file mode 100644
index 0000000..3f315da
--- /dev/null
+++ b/tests/unit/test_unknown_pointer_decls.py
@@ -0,0 +1,67 @@
+import unittest
+
+from m2c.options import Formatter
+from m2c.types import Type, TypeData
+from m2c.translate import Cast, GlobalSymbol
+from tests.unit import test_native_drafts
+
+
+class TestUnknownPointerDecls(unittest.TestCase):
+    def test_unsized_unknown_pointee_is_void_without_changing_inference(self):
+        target = Type.any()
+        pointer = Type.ptr(target)
+        self.assertEqual(pointer.format(Formatter(valid_syntax=True)), "void *")
+        self.assertTrue(target.is_unconstrained())
+        self.assertEqual(pointer.format(Formatter()), "? *")
+
+    def test_width_and_float_evidence_are_preserved(self):
+        for target, expected in ((Type.f32(), "f32 *"), (Type.s32(), "s32 *"),
+                                 (Type(TypeData(size_bits=32)), "M2C_UNK32 *")):
+            self.assertEqual(Type.ptr(target).format(Formatter(valid_syntax=True)), expected)
+        likely_float = Type(TypeData(likely_kind=TypeData.K_FLOAT))
+        self.assertFalse(likely_float.is_unconstrained())
+        self.assertEqual(Type.ptr(likely_float).format(Formatter(valid_syntax=True)), "f32 *")
+
+    def test_unknown_values_are_not_replaced_with_void(self):
+        self.assertEqual(Type.any().format(Formatter(valid_syntax=True)), "M2C_UNK")
+
+    def test_silent_register_casts_keep_required_integer_pointer_conversions(self):
+        pointer = Type.ptr(Type.s32())
+        to_pointer = Cast(GlobalSymbol("address", Type.s32()), pointer, reinterpret=True, silent=True)
+        self.assertEqual(to_pointer.format(Formatter(valid_syntax=True)), "(s32 *) address")
+        self.assertEqual(to_pointer.format(Formatter()), "address")
+        to_integer = Cast(GlobalSymbol("address", pointer), Type.s32(), reinterpret=True, silent=True)
+        self.assertEqual(to_integer.format(Formatter(valid_syntax=True)), "(s32) address")
+        self.assertEqual(to_integer.format(Formatter()), "address")
+
+    def test_context_integer_return_used_as_memory_address_has_explicit_cast(self):
+        code = test_native_drafts.TestNativeDrafts().translate(
+            "stwu r1,-16(r1)\nmflr r0\nstw r0,20(r1)\nbl lookup\n"
+            "cmplwi r3,0\nbeq .Lzero\nlbz r0,1(r3)\ncmplwi r0,0\nbeq .Lload\n"
+            ".Lzero:\nli r3,0\nb .Ldone\n.Lload:\nlwz r3,4(r3)\n.Ldone:\n"
+            "lwz r0,20(r1)\nmtlr r0\naddi r1,r1,16\nblr",
+            "int test(void); int lookup();")
+        self.assertIn("int lookup(", code)
+        self.assertIn("(void *) lookup(", code)
+
+    def test_unused_callee_return_can_be_declared_void(self):
+        code = test_native_drafts.TestNativeDrafts().translate(
+            "stwu r1,-16(r1)\nmflr r0\nstw r0,20(r1)\nbl notify\n"
+            "lwz r0,20(r1)\nmtlr r0\naddi r1,r1,16\nblr", "void test(void);")
+        self.assertIn("void notify(", code)
+        self.assertIn("return value unused", code)
+        self.assertNotIn("M2C_UNK", code)
+
+    def test_used_and_authoritative_callee_returns_are_preserved(self):
+        code = test_native_drafts.TestNativeDrafts().translate("b lookup", "int test(void);")
+        self.assertIn("s32 lookup(", code)
+        self.assertNotIn("void lookup(", code)
+        code = test_native_drafts.TestNativeDrafts().translate(
+            "stwu r1,-16(r1)\nmflr r0\nstw r0,20(r1)\nbl notify\n"
+            "lwz r0,20(r1)\nmtlr r0\naddi r1,r1,16\nblr",
+            "void test(void); double notify(void);")
+        self.assertIn("double notify(void);", code)
+
+
+if __name__ == "__main__":
+    unittest.main()
