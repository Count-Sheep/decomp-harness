+    def test_sized_offset_preserves_the_inferred_result_representation(self):
+        fmt = Formatter(valid_syntax=True)
+        for element in (Type.u8(), Type.u32()):
+            pointer = GlobalSymbol('cursor', Type.ptr(element))
+            for result in (Type.s32(), Type.intptr(), Type.ptr(Type.ptr(Type.u8()))):
+                for offset in (Literal(8), GlobalSymbol('step', Type.s32())):
+                    for op in ('+', '-'):
+                        expr = BinaryOp(pointer, op, offset, result)
+                        expected = f'(({result.format(fmt)}) ((char *) cursor {op} {offset.format(fmt)}))'
+                        self.assertEqual(expr.format(fmt), expected)
+        pointer = GlobalSymbol('cursor', Type.ptr(Type.u32()))
+        expr = BinaryOp(pointer, '+', Literal(8), Type.s32())
+        self.assertEqual(expr.format(Formatter()), '(cursor + 2)')
+        self.assertEqual(pointer.type.format(fmt), 'u32 *')
+
+    @unittest.skipUnless(shutil.which('clang'), 'Clang required for C89 syntax checks')
+    def test_sized_result_conversions_compile_as_powerpc_c89(self):
+        fmt = Formatter(valid_syntax=True)
+        source = 'typedef unsigned char u8; typedef unsigned int u32; typedef int s32;\n'
+        for index, element in enumerate((Type.u8(), Type.u32())):
+            pointer = GlobalSymbol('cursor', Type.ptr(element))
+            for suffix, result in (('integer', Type.s32()), ('pointer', Type.ptr(Type.ptr(Type.u8())))):
+                expr = BinaryOp(pointer, '-', GlobalSymbol('step', Type.s32()), result)
+                source += (f'{result.format(fmt)} test_{index}_{suffix}({pointer.type.format(fmt)} cursor, s32 step) '
+                           f'{{ return {expr.format(fmt)}; }}\n')
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'draft.c'
+            path.write_text(source)
+            result = subprocess.run([shutil.which('clang'), '-target', 'powerpc-unknown-none',
+                                     '-std=c89', '-fsyntax-only', '-Werror', str(path)],
+                                    capture_output=True, text=True, timeout=30)
+            self.assertEqual(result.returncode, 0, source + result.stderr)
+
