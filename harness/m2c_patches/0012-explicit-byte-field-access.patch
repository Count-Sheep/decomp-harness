diff --git a/tests/unit/test_explicit_fields.py b/tests/unit/test_explicit_fields.py
new file mode 100644
--- /dev/null
+++ b/tests/unit/test_explicit_fields.py
@@ -0,0 +1,86 @@
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+from types import SimpleNamespace
+import unittest
+
+from m2c.main import parse_flags
+from m2c.options import Formatter
+from m2c.translate import GlobalSymbol, StructAccess
+from m2c.types import Type
+from run_tests import decompile_and_capture_output
+
+
+class TestExplicitFields(unittest.TestCase):
+    def access(self, offset=4, element=None, name="ptr", path=None, stack=None):
+        return StructAccess(GlobalSymbol(name, Type.ptr()), offset, 4,
+                            [0] if path is None else path, stack, element or Type.s32())
+
+    def test_default_macro_and_opt_in_expansion_match_the_existing_contract(self):
+        access = self.access()
+        self.assertEqual(access.format(Formatter(valid_syntax=True)), "M2C_FIELD(ptr, s32 *, 4)")
+        self.assertEqual(access.format(Formatter(valid_syntax=True, explicit_field_access=True)),
+                         "(*(s32 *)((char *)(ptr) + (4)))")
+        self.assertEqual(access.offset, 4)
+        self.assertEqual(access.field_path, [0])
+
+    def test_signed_offsets_widths_and_zero_offset_are_not_guessed(self):
+        formatter = Formatter(valid_syntax=True, explicit_field_access=True)
+        for offset in (-8, 1, 4, 12):
+            for element in (Type.u8(), Type.s16(), Type.u32(), Type.f32(), Type.f64()):
+                access = self.access(offset, element)
+                result = access.format(formatter)
+                self.assertIn(Type.ptr(element).format(formatter), result)
+                self.assertIn("+ (" + formatter.format_int(offset) + ")", result)
+                self.assertNotIn("M2C_FIELD", result)
+        zero = self.access(0, stack=SimpleNamespace(has_nonzero_access=lambda var: True))
+        self.assertIn("+ (0)", zero.format(formatter))
+
+    def test_known_field_paths_and_non_valid_syntax_remain_unchanged(self):
+        known = self.access(path=[0, "value"])
+        self.assertEqual(known.format(Formatter(valid_syntax=True, explicit_field_access=True)), "ptr->value")
+        access = self.access()
+        self.assertEqual(access.format(Formatter(explicit_field_access=True)), access.format(Formatter()))
+
+    def test_cli_wires_option_into_formatter(self):
+        options = parse_flags(["--target", "ppc-mwcc-c", "--valid-syntax", "--explicit-field-access", "test.s"])
+        self.assertTrue(options.formatter().explicit_field_access)
+        self.assertTrue(options.formatter().valid_syntax)
+        self.assertFalse(parse_flags(["test.s"]).formatter().explicit_field_access)
+
+    def test_real_ppc_translation_emits_native_load_without_a_fake_struct(self):
+        with tempfile.TemporaryDirectory() as name:
+            root = Path(name)
+            asm = root / "target.s"
+            context = root / "context.c"
+            asm.write_text(".fn test, global\nlwz r3,4(r3)\nblr\n.endfn test\n")
+            context.write_text("int test(void *ptr);")
+            flags = ["--target", "ppc-mwcc-c", "--valid-syntax", "--no-unk-inference", "--no-cache",
+                     "--context", str(context), str(asm)]
+            macro = decompile_and_capture_output(parse_flags(flags))
+            native = decompile_and_capture_output(parse_flags(["--explicit-field-access", *flags]))
+        self.assertIn("M2C_FIELD", macro)
+        self.assertNotIn("M2C_FIELD", native)
+        self.assertNotIn("->unk", native)
+        self.assertIn("(char *)(ptr)", native)
+
+    @unittest.skipUnless(shutil.which("clang"), "Clang is required for an independent C execution check")
+    def test_compiled_access_preserves_lvalues_signed_offsets_and_single_evaluation(self):
+        native = self.access(4, Type.u32(), "next()").format(Formatter(valid_syntax=True, explicit_field_access=True))
+        negative = self.access(-4, Type.u32(), "values + 2").format(Formatter(valid_syntax=True, explicit_field_access=True))
+        source = ("typedef unsigned int u32; static u32 values[3] = {1, 2, 3}; static int calls; "
+                  "static void *next(void) { calls++; return values; } "
+                  "int main(void) { " + native + " = 9; if(calls != 1 || values[1] != 9) return 1; "
+                  "return " + negative + " != 9; }")
+        with tempfile.TemporaryDirectory() as name:
+            path, executable = Path(name) / "test.c", Path(name) / "test"
+            path.write_text(source)
+            result = subprocess.run([shutil.which("clang"), "-std=c89", "-Wall", "-Werror", "-O2",
+                                     str(path), "-o", str(executable)], capture_output=True, text=True, timeout=30)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(subprocess.run([str(executable)], timeout=10).returncode, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
