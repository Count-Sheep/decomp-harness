+def remove_mwcc_section_attributes(source: str) -> str:
+    """Ignore section placement for type parsing, retaining all ABI attributes."""
+    if "__declspec" not in source:
+        return source
+
+    def fail(message: str, line: int, column: int) -> None:
+        raise DecompFailure(f"Cannot tokenize C context at line {line}: {message}")
+
+    lexer = CLexer(fail, lambda: None, lambda: None, lambda name: False)
+    lexer.build()
+    lexer.input(source)
+    tokens = []
+    while token := lexer.token():
+        tokens.append(token)
+    ranges = []
+    for index, token in enumerate(tokens):
+        if token.type != "ID" or token.value != "__declspec":
+            continue
+        arguments = tokens[index + 1:index + 5]
+        if (len(arguments) == 4
+                and [argument.type for argument in arguments] == ["LPAREN", "ID", "STRING_LITERAL", "RPAREN"]
+                and arguments[1].value == "section"):
+            ranges.append((token.lexpos, arguments[-1].lexpos + 1))
+    # Preserve coordinates, including newlines and columns, in parser diagnostics.
+    result, cursor = [], 0
+    for start, end in ranges:
+        result.extend((source[cursor:start], "".join("\n" if char == "\n" else " " for char in source[start:end])))
+        cursor = end
+    return "".join(result) + source[cursor:]
+
+
 def parse_c(
     source: str, initial_scope: CParserScope
 ) -> Tuple[ca.FileAST, CParserScope]:
+    source = remove_mwcc_section_attributes(source)
