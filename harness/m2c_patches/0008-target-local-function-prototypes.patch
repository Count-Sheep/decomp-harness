+    def test_implicit_extern_prototypes_preserve_return_and_parameter_types(self):
+        self.path.write_text('''
+struct Entry { int key; int value; };
+int first(void) {
+    struct Entry *lookup(unsigned int);
+    unsigned short count(void *, unsigned int *, unsigned int);
+    double sample(float);
+    int (*callback)(void);
+    int local;
+    { float nested(void); }
+    return 0;
+}
+int second(void) {
+    float lookup(double);
+    return 0;
+}
+''')
+        types = build_typemap([self.path], self.arch, False, context_function='first')
+        self.assertEqual(to_c(types.functions['lookup'].ret_type), 'struct Entry *')
+        self.assertEqual([to_c(p.type) for p in types.functions['lookup'].params], ['unsigned int'])
+        self.assertEqual(to_c(types.functions['count'].ret_type), 'unsigned short')
+        self.assertEqual([to_c(p.type) for p in types.functions['count'].params],
+                         ['void *', 'unsigned int *', 'unsigned int'])
+        self.assertEqual(to_c(types.functions['sample'].ret_type), 'double')
+        self.assertEqual([to_c(p.type) for p in types.functions['sample'].params], ['float'])
+        self.assertEqual(set(types.local_declarations['first']), {'lookup', 'count', 'sample'})
+        for name in ('callback', 'local', 'nested'):
+            self.assertNotIn(name, types.var_types)
+            self.assertNotIn(name, types.functions)
+
+    def test_implicit_extern_prototypes_respect_target_scope_and_global_types(self):
+        self.path.write_text('''
+int existing(void);
+int first(void) {
+    long value(void);
+    float existing(void);
+    return 0;
+}
+int second(void) {
+    float value(double);
+    return 0;
+}
+''')
+        first = build_typemap([self.path], self.arch, True, context_function='first')
+        second = build_typemap([self.path], self.arch, True, context_function='second')
+        default = build_typemap([self.path], self.arch, False)
+        self.assertEqual(to_c(first.functions['value'].ret_type), 'long')
+        self.assertEqual(first.functions['value'].params, [])
+        self.assertEqual(to_c(second.functions['value'].ret_type), 'float')
+        self.assertEqual([to_c(p.type) for p in second.functions['value'].params], ['double'])
+        self.assertEqual(to_c(first.functions['existing'].ret_type), 'int')
+        self.assertNotIn('existing', first.local_declarations['first'])
+        self.assertNotIn('value', default.functions)
+
+    def test_implicit_extern_prototypes_with_private_types_are_excluded(self):
+        self.path.write_text('''
+struct Entry { int key; };
+int first(void) {
+    typedef double Private;
+    struct Entry { float value; };
+    Private private_result(void);
+    int private_parameter(Private);
+    struct Entry *private_tag(void);
+    int ordinary(int);
+    return 0;
+}
+''')
+        types = build_typemap([self.path], self.arch, False, context_function='first')
+        for name in ('private_result', 'private_parameter', 'private_tag'):
+            self.assertNotIn(name, types.functions)
+            self.assertNotIn(name, types.var_types)
+        self.assertEqual(to_c(types.functions['ordinary'].ret_type), 'int')
+
+    def test_named_aggregate_externs_retain_names_and_qualifiers(self):
+        self.path.write_text('''
+struct Entry { int value; };
+union Value { int word; float real; };
+enum Mode { OFF, ON };
+int first(void) {
+    extern const struct Entry entry;
+    extern union Value value;
+    extern enum Mode mode;
+    return 0;
+}
+''')
+        types = build_typemap([self.path], self.arch, False, context_function='first')
+        declarations = types.local_declarations['first']
