+        self.assertEqual(type_to_string(declarations['value'], 'value'), 'union Value value')
+        self.assertEqual(type_to_string(declarations['mode'], 'mode'), 'enum Mode mode')
+        self.assertEqual(type_to_string(declarations['entry']), 'struct Entry')
