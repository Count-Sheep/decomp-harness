diff --git a/tests/unit/test_ppc_stack_storage.py b/tests/unit/test_ppc_stack_storage.py
new file mode 100644
index 0000000..c0fc034
--- /dev/null
+++ b/tests/unit/test_ppc_stack_storage.py
@@ -0,0 +1,74 @@
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+from m2c.main import parse_flags
+from run_tests import decompile_and_capture_output
+
+
+BODY = """stwu r1,-32(r1)
+mflr r0
+stw r0,36(r1)
+stw r31,28(r1)
+addi r3,r1,8
+bl fill
+lwz r3,8(r1)
+lwz r4,12(r1)
+add r3,r3,r4
+lwz r31,28(r1)
+lwz r0,36(r1)
+mtlr r0
+addi r1,r1,32
+blr"""
+
+
+class TestPpcStackStorage(unittest.TestCase):
+    def translate(self, enabled=True, body=BODY):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "target.s").write_text(".fn test, global\n" + body + "\n.endfn test\n")
+            (root / "context.c").write_text("int test(void); void fill(void *);")
+            flags = ["-t", "ppc-mwcc-c", "--valid-syntax", "--no-cache", "--globals", "used-context",
+                     "--context", str(root / "context.c"), str(root / "target.s")]
+            if enabled:
+                flags.append("--ppc-stack-storage")
+            return decompile_and_capture_output(parse_flags(flags))
+
+    def test_address_exposed_stack_uses_one_bounded_region(self):
+        code = self.translate()
+        self.assertIn("union _m2c_stack_test_storage sp8;", code)
+        self.assertIn("u8[0x14]", code)
+        self.assertIn("sp8.u32[0]", code)
+        self.assertIn("sp8.u32[1]", code)
+        self.assertNotIn("u64[", code)
+        self.assertNotIn("spC", code)
+        self.assertNotIn("_storage", self.translate(enabled=False))
+
+    @unittest.skipUnless(shutil.which("clang"), "Clang required for raw C syntax checks")
+    def test_raw_generated_storage_compiles_without_missing_locals(self):
+        code = self.translate()
+        with tempfile.TemporaryDirectory() as directory:
+            source = Path(directory) / "draft.c"
+            source.write_text("typedef unsigned char u8; typedef signed char s8;\n"
+                              "typedef unsigned short u16; typedef short s16;\n"
+                              "typedef unsigned int u32; typedef int s32; typedef float f32;\n" + code)
+            result = subprocess.run([shutil.which("clang"), "-target", "powerpc-unknown-none",
+                                     "-std=c89", "-fsyntax-only", "-Werror", str(source)],
+                                    capture_output=True, text=True, timeout=30)
+            self.assertEqual(result.returncode, 0, code + result.stderr)
+
+    def test_mixed_access_widths_keep_byte_offsets_and_signedness(self):
+        code = self.translate(body=BODY.replace("lwz r3,8(r1)", "lha r3,10(r1)")
+                                      .replace("lwz r4,12(r1)", "lbz r4,9(r1)"))
+        self.assertIn("sp8.s16[1]", code)
+        self.assertIn("sp8.u8[1]", code)
+
+    def test_unsupported_alignment_does_not_extend_into_saved_registers(self):
+        code = self.translate(body=BODY.replace("lwz r3,8(r1)", "lfd f1,8(r1)"))
+        self.assertIn("PPC stack storage has unsupported alignment", code)
+
+
+if __name__ == "__main__":
+    unittest.main()
