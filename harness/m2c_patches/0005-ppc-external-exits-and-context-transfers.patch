diff --git a/tests/unit/test_tail_calls.py b/tests/unit/test_tail_calls.py
new file mode 100644
index 0000000..1704542
--- /dev/null
+++ b/tests/unit/test_tail_calls.py
@@ -0,0 +1,99 @@
+import unittest
+from pathlib import Path
+
+from m2c.arch_ppc import ContextTransferPattern, PpcArch, TailCallPattern
+from m2c.asm_file import AsmData, AsmDataEntry, AsmSymbolicData, Label
+from m2c.asm_instruction import AsmAddressMode, AsmGlobalSymbol, AsmLiteral, Register
+from m2c.asm_pattern import AsmMatcher
+from m2c.instruction import InstructionMeta
+from m2c.main import parse_flags
+from run_tests import decompile_and_capture_output
+
+
+class TestPpcTailCalls(unittest.TestCase):
+    def match(self, mnemonic, args, labels=()):
+        arch = PpcArch()
+        instruction = arch.parse(mnemonic, args, InstructionMeta.missing())
+        trailing = arch.parse('blr', [], InstructionMeta.missing())
+        matcher = AsmMatcher(arch, AsmData(), [instruction, trailing], set(labels))
+        return TailCallPattern().match(matcher)
+
+    def test_unconditional_exit_is_recognized_before_trailing_instructions(self):
+        result = self.match('b', [AsmGlobalSymbol('helper')])
+        self.assertEqual([item.mnemonic for item in result.new_body], ['bl', 'blr'])
+        self.assertEqual(result.num_consumed, 1)
+
+    def test_conditional_exit_preserves_nondefault_condition_field(self):
+        result = self.match('bne', [Register('cr3'), AsmGlobalSymbol('helper')])
+        branch, call, ret, label = result.new_body
+        self.assertEqual(branch.mnemonic, 'beq')
+        self.assertEqual(branch.args[0], Register('cr3'))
+        self.assertEqual(branch.args[-1], AsmGlobalSymbol(label.names[0]))
+        self.assertEqual(call.args, [AsmGlobalSymbol('helper')])
+        self.assertEqual(ret.mnemonic, 'blr')
+
+    def test_conditional_exit_avoids_existing_label_collision(self):
+        result = self.match('beq', [AsmGlobalSymbol('helper')], ['._m2c_tail_0'])
+        self.assertEqual(result.new_body[-1], Label.new('._m2c_tail_0_'))
+
+    def test_local_branch_and_missing_local_label_are_not_calls(self):
+        self.assertIsNone(self.match('b', [AsmGlobalSymbol('test')], ['test']))
+        self.assertIsNone(self.match('b', [AsmGlobalSymbol('.L_missing')]))
+        self.assertIsNone(self.match('bne', [AsmGlobalSymbol('.L_missing')]))
+
+    def test_counter_branch_is_not_reinterpreted_as_condition_register_branch(self):
+        self.assertIsNone(self.match('bdnz', [AsmGlobalSymbol('helper')]))
+
+
+class TestContextTransfers(unittest.TestCase):
+    def match(self, base, restore_lr=True, trailing=False, case_table=False, indexed_load=False):
+        arch = PpcArch()
+        meta = InstructionMeta.missing()
+        body = [arch.parse('lwz', [Register('r1'), AsmAddressMode(Register(base), AsmLiteral(8), None)], meta)]
+        if indexed_load:
+            body.append(arch.parse('lwzx', [Register('r0'), Register('r3'), Register('r4')], meta))
+        if restore_lr:
+            body.append(arch.parse('mtlr', [Register('r0')], meta))
+        body.append(arch.parse('bctr', [], meta))
+        index = len(body) - 1
+        if trailing:
+            body.append(Label.new('.L_case'))
+        data = AsmData()
+        labels = set()
+        if case_table:
+            labels.add('.L_case')
+            data.values['table'] = AsmDataEntry(('test', 0), [AsmSymbolicData(AsmGlobalSymbol('.L_case'), 4)])
+        return ContextTransferPattern().match(AsmMatcher(arch, data, body, labels, index=index))
+
+    def test_foreign_stack_and_lr_transfer_is_retained_as_opaque_not_a_call(self):
+        result = self.match('r3')
+        self.assertEqual(result.new_body[0].mnemonic, 'bctr.context_transfer')
+        instruction = PpcArch.parse('bctr.context_transfer', [], InstructionMeta.missing())
+        self.assertTrue(instruction.is_return)
+        self.assertTrue(instruction.is_noreturn)
+        self.assertEqual(instruction.inputs, [Register('ctr'), Register('lr'), Register('r1')])
+
+    def test_ordinary_stack_restore_and_nonterminal_switch_stay_unchanged(self):
+        self.assertIsNone(self.match('r1'))
+        self.assertIsNone(self.match('r3', restore_lr=False))
+        self.assertIsNone(self.match('r3', trailing=True))
+
+    def test_local_case_table_is_not_hidden_by_opaque_transfer(self):
+        self.assertIsNone(self.match('r3', case_table=True))
+
+    def test_indexed_load_keeps_unknown_switch_table_diagnostic(self):
+        self.assertIsNone(self.match('r3', indexed_load=True))
+
+    def test_untyped_context_transfer_does_not_invent_a_return_value(self):
+        fixture = Path(__file__).parents[1] / 'end_to_end/ppc-context-transfer/manual.s'
+        options = parse_flags(['--target', 'ppc-mwcc-c', '--function', 'test',
+                               '--no-unk-inference', '--valid-syntax', str(fixture)])
+        output = decompile_and_capture_output(options)
+        self.assertIn('void test(', output)
+        self.assertIn('M2C_UNRESOLVED_CONTEXT_TRANSFER', output)
+        self.assertNotIn('return ', output)
+        self.assertIn('= ', output)
+
+
+if __name__ == '__main__':
+    unittest.main()
