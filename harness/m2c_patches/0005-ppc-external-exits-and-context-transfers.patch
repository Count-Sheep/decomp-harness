+        instr = matcher.input[matcher.index]
+        inverses = {
+            "beq": "bne", "bne": "beq", "bge": "blt", "blt": "bge",
+            "bgt": "ble", "ble": "bgt", "bns": "bso", "bso": "bns",
+        }
+        if not isinstance(instr, Instruction) or instr.mnemonic not in {"b", *inverses}:
+            return None
+        target = instr.args[-1]
+        if not isinstance(target, AsmGlobalSymbol) or matcher.is_local_label(target.symbol_name):
             return None
+        if target.symbol_name.startswith("."):
+            return None
+        body = [AsmInstruction("bl", [target]), AsmInstruction("blr", [])]
+        if instr.mnemonic == "b":
+            return Replacement(body, 1)
+        label = f"._m2c_tail_{matcher.index}"
+        while label in matcher.labels:
+            label += "_"
+        return Replacement([
+            AsmInstruction(inverses[instr.mnemonic], [*instr.args[:-1], AsmGlobalSymbol(label)]),
+            *body,
+            Label.new(label),
+        ], 1)
