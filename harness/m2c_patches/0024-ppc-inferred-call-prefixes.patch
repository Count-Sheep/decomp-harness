+    def test_prior_inferred_parameters_preserve_available_register_prefix(self):
+        sig = FunctionSignature(params=[FunctionParam(Type.intptr())])
+        self.assertEqual(self.slots({'r3': False, 'r4': False}, sig), ['r3'])
+        self.assertEqual(self.slots({'r4': False}, sig), [])
+        mixed = FunctionSignature(params=[FunctionParam(Type.u32()), FunctionParam(Type.f32())])
+        self.assertEqual(self.slots({'r3': False, 'f1': False}, mixed), ['r3', 'f1'])
+        reversed_classes = FunctionSignature(params=[FunctionParam(Type.f32()), FunctionParam(Type.u32())])
+        self.assertEqual(self.slots({'r3': False, 'f1': False}, reversed_classes), [])
+        unknown = FunctionSignature(params=[FunctionParam(Type.any())])
+        self.assertEqual(self.slots({'r3': False}, unknown), [])
+        wide = FunctionSignature(params=[FunctionParam(Type.u64())])
+        self.assertEqual(self.slots({'r3': False, 'r4': False}, wide), [])
