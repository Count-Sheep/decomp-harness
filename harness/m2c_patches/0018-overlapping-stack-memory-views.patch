diff --git a/tests/unit/test_stack_memory_views.py b/tests/unit/test_stack_memory_views.py
new file mode 100644
index 0000000..ec77f22
--- /dev/null
+++ b/tests/unit/test_stack_memory_views.py
@@ -0,0 +1,84 @@
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+from m2c.main import parse_flags
+from run_tests import decompile_and_capture_output
+
+
+class TestStackMemoryViews(unittest.TestCase):
+    def translate(self, instructions, context="unsigned int test(unsigned int value);"):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            target = root / "target.s"
+            target.write_text(".fn test, global\nstwu r1,-16(r1)\n" + instructions
+                              + "\naddi r1,r1,16\nblr\n.endfn test\n")
+            header = root / "context.c"
+            header.write_text(context)
+            return decompile_and_capture_output(parse_flags([
+                "-t", "ppc-mwcc-c", "--valid-syntax", "--no-cache",
+                "--explicit-field-access", "--context", str(header), str(target)]))
+
+    def test_byte_reads_share_word_backing_at_each_offset(self):
+        for offset in range(4):
+            with self.subTest(offset=offset):
+                output = self.translate(f"stw r3,8(r1)\nlbz r3,{8 + offset}(r1)")
+                self.assertIn("sp8.u32[0] = value;", output)
+                self.assertIn(f"return (u32) sp8.u8[{offset}];", output)
+                self.assertNotIn("unksp", output)
+
+    def test_halfword_read_preserves_signedness(self):
+        for opcode, prefix in (("lha", "s"), ("lhz", "u")):
+            output = self.translate(f"stw r3,8(r1)\n{opcode} r3,10(r1)")
+            self.assertIn(f"sp8.{prefix}16[1]", output)
+
+    def test_narrow_store_before_wide_read_has_full_backing(self):
+        output = self.translate("sth r3,8(r1)\nsth r3,10(r1)\nlwz r3,8(r1)")
+        self.assertIn("u32 u32[1]", output)
+        self.assertIn("sp8.u16[1]", output)
+        self.assertIn("return sp8.u32[0];", output)
+
+    def test_partial_write_does_not_forward_old_word(self):
+        output = self.translate("stw r3,8(r1)\nli r4,0\nstb r4,9(r1)\nlwz r3,8(r1)")
+        self.assertIn("sp8.u8[1] = 0;", output)
+        self.assertIn("return sp8.u32[0];", output)
+        self.assertNotIn("return value;", output)
+
+    def test_nonoverlapping_locals_do_not_need_union(self):
+        output = self.translate("stw r3,8(r1)\nstw r3,12(r1)\nlwz r3,8(r1)")
+        self.assertNotIn("union", output)
+
+    def test_quantized_store_is_not_silently_discarded(self):
+        output = self.translate("psq_st f1,8(r1),1,qr3\nlhz r3,8(r1)",
+                                "unsigned short test(float value);")
+        self.assertIn("psq_st requires quantization state", output)
+        self.assertNotIn("return sp8", output)
+
+    @unittest.skipUnless(shutil.which("clang"), "Clang required for big-endian codegen")
+    def test_big_endian_byte_selection_is_not_numeric_truncation(self):
+        targets = subprocess.run([shutil.which("clang"), "--print-targets"],
+                                 capture_output=True, text=True, timeout=30)
+        if "armeb" not in targets.stdout:
+            self.skipTest("No ARM big-endian compiler backend")
+        for offset, expected in enumerate((17, 34, 51, 68)):
+            output = self.translate(f"stw r3,8(r1)\nlbz r3,{8 + offset}(r1)")
+            with self.subTest(offset=offset), tempfile.TemporaryDirectory() as directory:
+                source = Path(directory) / "probe.c"
+                source.write_text("typedef unsigned char u8; typedef signed char s8;\n"
+                                  "typedef unsigned short u16; typedef short s16;\n"
+                                  "typedef unsigned int u32; typedef int s32; typedef float f32;\n"
+                                  + output + "\nunsigned int probe(void) { return test(0x11223344U); }\n")
+                result = subprocess.run([shutil.which("clang"), "-target", "armeb-unknown-linux-gnueabi",
+                                         "-ffreestanding", "-std=c89", "-O2", "-S", str(source), "-o", "-"],
+                                        capture_output=True, text=True, timeout=30)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                probe = result.stdout.split("probe:", 1)[1].split(".Lfunc_end", 1)[0]
+                self.assertRegex(probe, rf"mov\s+r0, #{expected}\b")
+
+    def test_read_before_overlapping_write_is_materialized(self):
+        output = self.translate("stw r3,8(r1)\nlbz r4,9(r1)\nli r5,0\n"
+                                "stb r5,9(r1)\nlwz r3,8(r1)\nadd r3,r3,r4")
+        self.assertRegex(output, r"temp_\w+ = sp8.u8\[1\];")
+        self.assertLess(output.index("= sp8.u8[1];"), output.index("sp8.u8[1] = 0;"))
