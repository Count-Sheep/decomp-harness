diff --git a/tests/unit/test_switch_tables.py b/tests/unit/test_switch_tables.py
new file mode 100644
index 0000000..2f15343
--- /dev/null
+++ b/tests/unit/test_switch_tables.py
@@ -0,0 +1,43 @@
+import io
+from pathlib import Path
+import unittest
+
+from m2c.arch_ppc import PpcArch
+from m2c.asm_file import parse_file
+from m2c.error import DecompFailure
+from m2c.flow_graph import SwitchNode, build_flowgraph
+from m2c.main import parse_flags
+
+
+class TestAnonymousSwitchTables(unittest.TestCase):
+    def graph(self, assembly):
+        arch = PpcArch()
+        options = parse_flags(['--target', 'ppc-mwcc-c', '-'])
+        stream = io.StringIO(assembly)
+        stream.name = 'anonymous-switch.s'
+        parsed = parse_file(stream, arch, options)
+        return build_flowgraph(parsed.functions[0], parsed.asm_data, arch, fragment=False)
+
+    def assembly(self):
+        fixture = Path(__file__).parents[1] / 'end_to_end/ppc-anonymous-switch/manual.s'
+        return fixture.read_text()
+
+    def test_real_local_case_addresses_do_not_require_a_name_prefix(self):
+        graph = self.graph(self.assembly())
+        switches = [node for node in graph.nodes if isinstance(node, SwitchNode)]
+        self.assertEqual(len(switches), 1)
+        self.assertEqual(len(switches[0].cases), 2)
+
+    def test_foreign_function_pointer_is_not_a_switch_case(self):
+        assembly = self.assembly().replace('.4byte .L_one', '.4byte other_function')
+        with self.assertRaisesRegex(DecompFailure, 'Unable to determine jump table'):
+            self.graph(assembly)
+
+    def test_numeric_data_is_not_a_switch_table(self):
+        assembly = self.assembly().replace('.4byte .L_zero', '.4byte 0').replace('.4byte .L_one', '.4byte 4')
+        with self.assertRaisesRegex(DecompFailure, 'Unable to determine jump table'):
+            self.graph(assembly)
+
+
+if __name__ == '__main__':
+    unittest.main()
