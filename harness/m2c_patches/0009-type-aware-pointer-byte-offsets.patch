diff --git a/tests/unit/test_pointer_offsets.py b/tests/unit/test_pointer_offsets.py
new file mode 100644
--- /dev/null
+++ b/tests/unit/test_pointer_offsets.py
@@ -0,0 +1,61 @@
+import unittest
+
+from m2c.options import Formatter
+from m2c.translate import BinaryOp, GlobalSymbol, Literal, format_assignment
+from m2c.types import Type
+
+
+class TestPointerOffsets(unittest.TestCase):
+    def test_literal_offsets_are_converted_from_bytes_without_changing_the_ir(self):
+        for element in (Type.u8(), Type.u16(), Type.u32(), Type.u64()):
+            size = element.get_size_bytes()
+            pointer = GlobalSymbol('cursor', Type.ptr(element))
+            for count in (-3, -1, 0, 1, 3):
+                with self.subTest(size=size, count=count):
+                    offset = Literal(count * size)
+                    expr = BinaryOp(pointer, '+', offset, pointer.type)
+                    formatted = expr.format(Formatter())
+                    op, magnitude = ('-', -count) if count < 0 else ('+', count)
+                    self.assertEqual(formatted, f'(cursor {op} {magnitude})')
+                    self.assertEqual(format_assignment(pointer, expr, Formatter()), f'cursor {op}= {magnitude};')
+                    self.assertEqual(expr.right.value, count * size)
+
+    def test_commutative_offsets_and_subtraction_preserve_byte_steps(self):
+        pointer = GlobalSymbol('cursor', Type.ptr(Type.u32()))
+        addition = BinaryOp(Literal(8), '+', pointer, pointer.type)
+        subtraction = BinaryOp(pointer, '-', Literal(12), pointer.type)
+        self.assertEqual(addition.format(Formatter()), '(cursor + 2)')
+        self.assertEqual(format_assignment(pointer, addition, Formatter()), 'cursor += 2;')
+        self.assertEqual(subtraction.format(Formatter()), '(cursor - 3)')
+
+    def test_partial_and_dynamic_offsets_keep_byte_arithmetic(self):
+        pointer = GlobalSymbol('cursor', Type.ptr(Type.u32()))
+        for offset in (Literal(2), GlobalSymbol('bytes', Type.u32())):
+            expr = BinaryOp(pointer, '+', offset, pointer.type)
+            formatted = expr.format(Formatter())
+            self.assertIn('(char *) cursor +', formatted)
+            self.assertIn('u32 *', formatted)
+            self.assertNotIn('cursor +=', format_assignment(pointer, expr, Formatter()))
+
+    def test_late_pointer_types_and_array_decay_use_the_final_element_size(self):
+        pointer = GlobalSymbol('cursor', Type.intptr())
+        expr = BinaryOp(pointer, '+', Literal(8), Type.intptr())
+        self.assertTrue(pointer.type.unify(Type.ptr(Type.u32())))
+        self.assertEqual(expr.format(Formatter()), '(cursor + 2)')
+        array = GlobalSymbol('values', Type.array(Type.u16(), 4))
+        self.assertEqual(BinaryOp(array, '+', Literal(2), Type.ptr()).format(Formatter()), '(values + 1)')
+
+    def test_integer_addition_and_character_pointer_steps_are_unchanged(self):
+        integer = GlobalSymbol('count', Type.s32())
+        expr = BinaryOp(integer, '+', Literal(4), integer.type)
+        self.assertEqual(expr.format(Formatter()), '(count + 4)')
+        self.assertEqual(format_assignment(integer, expr, Formatter()), 'count += 4;')
+        pointer = GlobalSymbol('cursor', Type.ptr(Type.u8()))
+        offset = GlobalSymbol('bytes', Type.s32())
+        self.assertEqual(BinaryOp(pointer, '+', offset, pointer.type).format(Formatter()), '(cursor + bytes)')
+        unknown = GlobalSymbol('opaque', Type.ptr())
+        self.assertEqual(BinaryOp(unknown, '+', Literal(4), unknown.type).format(Formatter()), '(opaque + 4)')
+
+
+if __name__ == '__main__':
+    unittest.main()
