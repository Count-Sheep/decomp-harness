diff --git a/tests/unit/test_c_symbol_name.py b/tests/unit/test_c_symbol_name.py
new file mode 100644
index 0000000..dede901
--- /dev/null
+++ b/tests/unit/test_c_symbol_name.py
@@ -0,0 +1,27 @@
+from pathlib import Path
+import tempfile
+import unittest
+
+from m2c.main import parse_flags
+from run_tests import decompile_and_capture_output
+
+
+class TestCSymbolName(unittest.TestCase):
+    def test_invalid_assembler_name_is_consistent_in_call_and_declaration(self):
+        with tempfile.TemporaryDirectory() as name:
+            root = Path(name)
+            (root / "target.s").write_text(
+                '.fn test, global\nbl "thisExec__5@unnamed@foo_cpp@Bar"\nblr\n.endfn test\n')
+            (root / "context.c").write_text("void test(void);")
+            output = decompile_and_capture_output(parse_flags([
+                "-t", "ppc-mwcc-c", "--valid-syntax", "--no-cache",
+                "--no-unk-inference", "--globals", "used-context",
+                "--context", str(root / "context.c"), str(root / "target.s")]))
+        spelling = "thisExec__5_unnamed_foo_cpp_Bar"
+        self.assertNotIn("@", output)
+        self.assertIn(f"void {spelling}(", output)
+        self.assertIn(f"{spelling}();", output)
+
+
+if __name__ == "__main__":
+    unittest.main()
