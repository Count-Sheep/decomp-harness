 class TestPointerOffsets(unittest.TestCase):
+    def test_valid_syntax_casts_both_orders_of_pointer_integer_comparisons(self):
+        fmt = Formatter(valid_syntax=True)
+        pointer = GlobalSymbol("cursor", Type.ptr(Type.u32()))
+        integer = GlobalSymbol("raw", Type.s32())
+        self.assertEqual(BinaryOp(pointer, "==", integer, Type.boolean()).format(fmt),
+                         "(cursor == (u32 *) raw)")
+        self.assertEqual(BinaryOp(integer, "!=", pointer, Type.boolean()).format(fmt),
+                         "((u32 *) raw != cursor)")
+        self.assertEqual(BinaryOp(pointer, "==", integer, Type.boolean()).format(Formatter()),
+                         "(cursor == raw)")
+
+    def test_large_global_offsets_are_materialized_at_signed_16_bit_boundary(self):
+        global_value = GlobalSymbol("table", Type.array(Type.u8(), 0x10000))
+        base = AddressOf(global_value)
+        for offset, transparent in ((-0x8000, True), (0x7FFF, True),
+                                    (-0x8001, False), (0x8000, False)):
+            access = StructAccess(base, offset, 4, [0], None, Type.u32())
+            with self.subTest(offset=offset):
+                self.assertEqual(should_wrap_transparently(access), transparent)
+
