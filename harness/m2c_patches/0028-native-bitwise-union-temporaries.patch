diff --git a/tests/unit/test_bitwise_temporaries.py b/tests/unit/test_bitwise_temporaries.py
new file mode 100644
index 0000000..2932260
--- /dev/null
+++ b/tests/unit/test_bitwise_temporaries.py
@@ -0,0 +1,99 @@
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+from m2c.options import Formatter
+from m2c.translate import Cast, GlobalSymbol, FuncCall
+from m2c.types import Type
+from tests.unit import test_native_drafts
+
+
+class TestBitwiseTemporaries(unittest.TestCase):
+    def test_file_scope_does_not_reference_undeclared_local_temporaries(self):
+        fmt = Formatter(valid_syntax=True)
+        expr = Cast(GlobalSymbol('value', Type.f32()), Type.u32(), reinterpret=True)
+        self.assertIn('M2C_BITWISE', expr.format(fmt))
+        self.assertEqual(fmt.bitwise_temporaries, [])
+
+    def test_native_function_emits_union_before_its_use(self):
+        code = test_native_drafts.TestNativeDrafts().translate(
+            'stwu r1,-16(r1)\nstfs f1,8(r1)\nlwz r3,8(r1)\naddi r1,r1,16\nblr',
+            'unsigned int test(float value);')
+        self.assertNotIn('M2C_BITWISE', code)
+        self.assertIn('union { f32 from; u32 to; } __m2c_bitcast_0;', code)
+        self.assertLess(code.index('union {'), code.index('__m2c_bitcast_0.from ='))
+
+    def test_known_equal_widths_use_distinct_union_temporaries(self):
+        fmt = Formatter(valid_syntax=True, bitwise_function_scope=True)
+        expr = Cast(GlobalSymbol('value', Type.f32()), Type.u32(), reinterpret=True)
+        self.assertEqual(expr.format(fmt), '(__m2c_bitcast_0.from = value, __m2c_bitcast_0.to)')
+        self.assertEqual(expr.format(fmt), '(__m2c_bitcast_1.from = value, __m2c_bitcast_1.to)')
+        self.assertEqual(fmt.bitwise_temporaries[0], 'union { f32 from; u32 to; } __m2c_bitcast_0;')
+        self.assertEqual(Formatter().bitwise_temporaries, [])
+        self.assertIn('(bitwise u32)', expr.format(Formatter()))
+
+    def test_unknown_or_mismatched_widths_remain_explicit(self):
+        for source, target in ((Type.f32(), Type.u64()), (Type.any(), Type.f32()),
+                               (Type.u16(), Type.f32()), (Type.ptr(), Type.f32())):
+            fmt = Formatter(valid_syntax=True, bitwise_function_scope=True)
+            expr = Cast(GlobalSymbol('value', source), target, reinterpret=True)
+            self.assertIn('M2C_BITWISE', expr.format(fmt))
+            self.assertEqual(fmt.bitwise_temporaries, [])
+
+    def test_narrow_integer_reads_low_bits_after_full_width_reinterpretation(self):
+        fmt = Formatter(valid_syntax=True, bitwise_function_scope=True)
+        result = Cast(GlobalSymbol('value', Type.f32()), Type.s8(), reinterpret=True).format(fmt)
+        self.assertIn('u32 to;', fmt.bitwise_temporaries[0])
+        self.assertTrue(result.startswith('((s8) '))
+        fmt = Formatter(valid_syntax=True, bitwise_function_scope=True)
+        result = Cast(GlobalSymbol('value', Type.f32()), Type.uintish(), reinterpret=True).format(fmt)
+        self.assertNotIn('M2C_BITWISE', result)
+        self.assertIn('u32 to;', fmt.bitwise_temporaries[0])
+
+    @unittest.skipUnless(shutil.which('clang'), 'Clang required for executable checks')
+    def test_float_bits_survive_round_trip(self):
+        fmt = Formatter(valid_syntax=True, bitwise_function_scope=True)
+        expr = Cast(Cast(GlobalSymbol('value', Type.u32()), Type.f32(), reinterpret=True),
+                    Type.u32(), reinterpret=True).format(fmt)
+        once_fmt = Formatter(valid_syntax=True, bitwise_function_scope=True)
+        call = FuncCall(GlobalSymbol('next_value', Type.any()), [], Type.f32())
+        once = Cast(call, Type.u32(), reinterpret=True).format(once_fmt)
+        narrow_fmt = Formatter(valid_syntax=True, bitwise_function_scope=True)
+        narrow = Cast(Cast(GlobalSymbol('value', Type.u32()), Type.f32(), reinterpret=True),
+                      Type.u8(), reinterpret=True).format(narrow_fmt)
+        text = ('typedef float f32; typedef unsigned int u32; typedef unsigned char u8;\n'
+                'u32 round_trip(u32 value) { ' + ' '.join(fmt.bitwise_temporaries)
+                + f' return {expr}; }}\n'
+                'static int calls; f32 next_value(void) { ++calls; return 1.0f; }\n'
+                'u32 once(void) { ' + ' '.join(once_fmt.bitwise_temporaries) + f' return {once}; }}\n'
+                'u8 narrow(u32 value) { ' + ' '.join(narrow_fmt.bitwise_temporaries) + f' return {narrow}; }}\n'
+                'int main(void) { return round_trip(0x3f800000U) != 0x3f800000U || '
+                'round_trip(0x80000000U) != 0x80000000U || round_trip(0) != 0 || '
+                'once() != 0x3f800000U || calls != 1 || narrow(0x3f8000abU) != 0xab; }\n')
+        with tempfile.TemporaryDirectory() as directory:
+            path, binary = Path(directory) / 'cast.c', Path(directory) / 'cast'
+            path.write_text(text)
+            result = subprocess.run([shutil.which('clang'), '-std=c89', '-Werror', '-O2',
+                                     str(path), '-o', str(binary)], capture_output=True, text=True, timeout=30)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(subprocess.run([str(binary)], timeout=30).returncode, 0)
+
+    @unittest.skipUnless(shutil.which('clang'), 'Clang required for C89 checks')
+    def test_generated_casts_compile_for_powerpc(self):
+        text = ('typedef float f32; typedef double f64; typedef unsigned int u32; '
+                'typedef unsigned long long u64;\n')
+        for index, (source, target) in enumerate(((Type.f32(), Type.u32()), (Type.u32(), Type.f32()),
+                                                (Type.f64(), Type.u64()), (Type.u64(), Type.f64()))):
+            fmt = Formatter(valid_syntax=True, bitwise_function_scope=True)
+            expr = Cast(GlobalSymbol('value', source), target, reinterpret=True).format(fmt)
+            text += (f'{target.format(fmt)} convert{index}({source.format(fmt)} value) {{ '
+                     + ' '.join(fmt.bitwise_temporaries) + f' return {expr}; }}\n')
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'cast.c'
+            path.write_text(text)
+            result = subprocess.run([shutil.which('clang'), '-target', 'powerpc-unknown-none',
+                                     '-std=c89', '-fsyntax-only', '-Werror', str(path)],
+                                    capture_output=True, text=True, timeout=30)
+            self.assertEqual(result.returncode, 0, text + result.stderr)
