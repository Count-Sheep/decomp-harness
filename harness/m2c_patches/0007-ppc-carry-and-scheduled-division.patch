diff --git a/tests/unit/test_ppc_carry.py b/tests/unit/test_ppc_carry.py
new file mode 100644
index 0000000..1babe0e
--- /dev/null
+++ b/tests/unit/test_ppc_carry.py
@@ -0,0 +1,124 @@
+import operator
+import random
+import unittest
+from unittest.mock import Mock
+
+from m2c.arch_ppc import PPC_CARRY_INPUT, PPC_CARRY_OUTPUT, PpcArch, ppc_carry_result
+from m2c.asm_instruction import AsmLiteral, Register
+from m2c.instruction import InstructionMeta
+from m2c.translate import BinaryOp, Cast, Literal, UnaryOp
+from m2c.types import Type
+
+MASK = (1 << 32) - 1
+
+
+def evaluate(expr):
+    if isinstance(expr, Literal):
+        value = expr.value
+    elif isinstance(expr, Cast):
+        value = evaluate(expr.expr)
+    elif isinstance(expr, UnaryOp):
+        value = {"!": lambda v: int(not v), "-": operator.neg}[expr.op](evaluate(expr.expr))
+    elif isinstance(expr, BinaryOp):
+        ops = {"+": operator.add, "-": operator.sub, "&": operator.and_,
+               "<": operator.lt, ">": operator.gt, "==": operator.eq,
+               ">=": operator.ge, "!=": operator.ne, ">>": operator.rshift,
+               "&&": lambda a, b: bool(a and b), "||": lambda a, b: bool(a or b)}
+        value = int(ops[expr.op](evaluate(expr.left), evaluate(expr.right)))
+    else:
+        raise AssertionError(type(expr))
+    bits = expr.type.get_size_bits() or 32
+    if expr.type.is_signed() or expr.type.is_unsigned():
+        value &= (1 << bits) - 1
+        if expr.type.is_signed() and value & (1 << (bits - 1)):
+            value -= 1 << bits
+    return value
+
+
+def arguments(left, right, carry):
+    args = Mock()
+    args.reg.side_effect = lambda index: Literal(left if index == 1 else right, type=Type.u32())
+    args.regs = {Register("carry"): Literal(carry, type=Type.boolean())}
+    args.imm_value.return_value = right
+    args.s16_imm.return_value = Literal((right & 0x7FFF) - (right & 0x8000))
+    return args
+
+
+class TestPpcCarry(unittest.TestCase):
+    def test_arithmetic_matches_independent_wide_integer_oracle(self):
+        edges = [0, 1, 2, 0x7FFFFFFF, 0x80000000, MASK - 1, MASK]
+        rng = random.Random(0xCA)
+        pairs = [(a, b) for a in edges for b in edges]
+        pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(100)]
+        for mnemonic in PPC_CARRY_OUTPUT - {"srawi"}:
+            for left, right in pairs:
+                for incoming in (0, 1):
+                    operand = right
+                    if mnemonic in {"addic", "subfic"}:
+                        operand = ((right & 0x7FFF) - (right & 0x8000)) & MASK
+                    elif mnemonic in {"addze", "subfze"}:
+                        operand = 0
+                    elif mnemonic in {"addme", "subfme"}:
+                        operand = MASK
+                    carry_in = incoming if mnemonic in PPC_CARRY_INPUT else int(mnemonic.startswith("sub"))
+                    wide = ((~left & MASK) if mnemonic.startswith("sub") else left) + operand + carry_in
+                    result, carry = ppc_carry_result(mnemonic, arguments(left, right, incoming))
+                    with self.subTest(op=mnemonic, a=left, b=right, ca=incoming):
+                        self.assertEqual(evaluate(result) & MASK, wide & MASK)
+                        self.assertEqual(evaluate(carry), int(wide > MASK))
+
+    def test_arithmetic_shift_carry_requires_negative_and_discarded_bits(self):
+        for left in [0, 1, 0x7FFFFFFF, 0x80000000, 0x80000001, MASK - 1, MASK]:
+            for shift in range(32):
+                result, carry = ppc_carry_result("srawi", arguments(left, shift, 0))
+                signed = left if left < 1 << 31 else left - (1 << 32)
+                with self.subTest(a=left, shift=shift):
+                    self.assertEqual(evaluate(result) & MASK, (signed >> shift) & MASK)
+                    self.assertEqual(evaluate(carry), int(signed < 0 and bool(left & ((1 << shift) - 1))))
+
+    def test_zero_mask_matches_addic_self_subfe(self):
+        for value in [0, 1, 2, 0x7FFFFFFF, 0x80000000, MASK - 1, MASK]:
+            args = Mock()
+            args.reg.return_value = Literal(value, type=Type.u32())
+            expr = PpcArch.instrs_dest_first_non_load["cmpzero.mask.fictive"](args)
+            wide = value + MASK
+            expected = -int(not (wide > MASK))
+            self.assertEqual(evaluate(expr), expected)
+
+    def test_carry_is_a_real_input_output_and_call_clobber(self):
+        for mnemonic in PPC_CARRY_OUTPUT:
+            raw = [Register("r3"), Register("r4")]
+            if mnemonic not in {"addme", "addze", "subfme", "subfze"}:
+                raw.append(AsmLiteral(1) if mnemonic in {"srawi", "addic", "subfic"} else Register("r5"))
+            for suffix in ("", "."):
+                instr = PpcArch.parse(mnemonic + suffix, raw, InstructionMeta.missing())
+                self.assertIn(Register("carry"), instr.outputs)
+                self.assertEqual(Register("carry") in instr.inputs, mnemonic in PPC_CARRY_INPUT)
+        self.assertIn(Register("carry"), PpcArch.temp_regs)
+        self.assertNotIn(Register("carry"), PpcArch.saved_regs)
+
+    def test_extended_chain_reads_original_operands_before_aliasing_write(self):
+        regs = {Register("r3"): Literal(MASK), Register("r4"): Literal(1),
+                Register("r5"): Literal(MASK), Register("r6"): Literal(0)}
+        state = Mock()
+        def assign(reg, value):
+            regs[reg] = value
+            return value
+        state.set_reg.side_effect = assign
+        for mnemonic, raw in [("addc", ["r3", "r3", "r4"]),
+                              ("adde", ["r5", "r5", "r6"]),
+                              ("addze", ["r4", "r5"])]:
+            raw = [Register(reg) for reg in raw]
+            args = Mock()
+            args.stack_info.is_stack_reg.return_value = False
+            args.regs = regs
+            args.reg_ref.side_effect = lambda index: raw[index]
+            args.reg.side_effect = lambda index: regs[raw[index]]
+            PpcArch.parse(mnemonic, raw, InstructionMeta.missing()).eval_fn(state, args)
+        self.assertEqual(evaluate(regs[Register("r3")]) & MASK, 0)
+        self.assertEqual(evaluate(regs[Register("r5")]), 0)
+        self.assertEqual(evaluate(regs[Register("r4")]), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
