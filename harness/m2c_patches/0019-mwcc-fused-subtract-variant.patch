diff --git a/tests/unit/test_fused_subtract_variant.py b/tests/unit/test_fused_subtract_variant.py
new file mode 100644
index 0000000..020dc01
--- /dev/null
+++ b/tests/unit/test_fused_subtract_variant.py
@@ -0,0 +1,29 @@
+from pathlib import Path
+import tempfile
+import unittest
+
+from m2c.main import parse_flags
+from run_tests import decompile_and_capture_output
+
+
+class TestFusedSubtractVariant(unittest.TestCase):
+    def translate(self, opcode, variant, scalar="double"):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            source, context = root / "target.s", root / "context.c"
+            source.write_text(f".fn test, global\n{opcode} f1,f1,f2,f3\nblr\n.endfn test\n")
+            context.write_text(f"{scalar} test({scalar} a, {scalar} b, {scalar} c);")
+            flags = ["-t", "ppc-mwcc-c", "--valid-syntax", "--no-cache", "--context", str(context), str(source)]
+            if variant:
+                flags.append("--mwcc-fused-subtract")
+            return decompile_and_capture_output(parse_flags(flags))
+
+    def test_default_retains_outer_negation(self):
+        self.assertIn("return -((a * b) - c);", self.translate("fnmsub", False))
+
+    def test_variant_changes_only_negative_subtraction(self):
+        for opcode, scalar in (("fnmsub", "double"), ("fnmsubs", "float")):
+            with self.subTest(opcode=opcode):
+                self.assertIn("return c - (a * b);", self.translate(opcode, True, scalar))
+        for opcode in ("fmadd", "fmsub", "fnmadd"):
+            self.assertEqual(self.translate(opcode, False), self.translate(opcode, True))
