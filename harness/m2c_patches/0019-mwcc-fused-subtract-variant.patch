+def negative_fused_subtract(args: InstrArgs, single: bool = False) -> Expression:
+    op = BinaryOp.f32 if single else BinaryOp.f64
+    product = op(args.reg(1), "*", args.reg(2))
+    info = args.stack_info.global_info
+    if info.mwcc_fused_subtract and info.target.compiler == Target.CompilerEnum.MWCC:
+        return op(args.reg(3), "-", product)
+    return UnaryOp("-", op(product, "-", args.reg(3)), type=Type.f32() if single else Type.f64())
