diff --git a/tests/unit/test_cr_logical.py b/tests/unit/test_cr_logical.py
new file mode 100644
index 0000000..7f2ae52
--- /dev/null
+++ b/tests/unit/test_cr_logical.py
@@ -0,0 +1,115 @@
+import math
+import unittest
+from types import SimpleNamespace
+
+from m2c.arch_ppc import PpcArch, cr_logical
+from m2c.asm_instruction import AsmGlobalSymbol, AsmInstruction, AsmLiteral, AsmState, Register
+from m2c.error import DecompFailure
+from m2c.instruction import InstructionMeta
+from m2c.translate import BinaryOp, Literal, UnaryOp
+from m2c.types import Type
+
+
+def evaluate(expr):
+    if isinstance(expr, Literal):
+        return expr.value
+    if isinstance(expr, UnaryOp) and expr.op == '!':
+        return not evaluate(expr.expr)
+    if isinstance(expr, BinaryOp):
+        a, b = evaluate(expr.left), evaluate(expr.right)
+        return {'&&': lambda: bool(a) and bool(b), '||': lambda: bool(a) or bool(b),
+                '==': lambda: a == b, '!=': lambda: a != b, '<': lambda: a < b,
+                '>': lambda: a > b, '<=': lambda: a <= b, '>=': lambda: a >= b}[expr.op]()
+    raise AssertionError(expr)
+
+
+class TestCrLogical(unittest.TestCase):
+    def parse(self, mnemonic, *bits):
+        return PpcArch.parse(mnemonic, [AsmLiteral(bit) for bit in bits], InstructionMeta.missing())
+
+    def test_truth_tables(self):
+        operations = {'cror': lambda a, b: a or b, 'crorc': lambda a, b: a or not b,
+                      'crand': lambda a, b: a and b, 'crandc': lambda a, b: a and not b,
+                      'crxor': lambda a, b: a != b, 'creqv': lambda a, b: a == b,
+                      'crnand': lambda a, b: not (a and b), 'crnor': lambda a, b: not (a or b)}
+        for mnemonic, operation in operations.items():
+            for a in (0, 1):
+                for b in (0, 1):
+                    with self.subTest(mnemonic=mnemonic, a=a, b=b):
+                        self.assertEqual(bool(evaluate(cr_logical(mnemonic, Literal(a), Literal(b)))), operation(a, b))
+
+    def test_reads_source_bits_and_only_writes_destination(self):
+        instruction = self.parse('cror', 30, 9, 22)
+        self.assertEqual(instruction.inputs, [Register('cr2_gt'), Register('cr5_eq')])
+        self.assertEqual(instruction.outputs, [Register('cr7_eq')])
+
+    def test_field_qualified_symbolic_operands_include_varargs_marker(self):
+        for field in range(8):
+            for index, bit in enumerate(('lt', 'gt', 'eq', 'so')):
+                raw = AsmInstruction('crclr', [AsmGlobalSymbol(f'cr{field}{bit}')])
+                normalized = PpcArch.normalize_instruction(raw, AsmState())
+                self.assertEqual(normalized.args, [AsmLiteral(4 * field + index)])
+                parsed = PpcArch.parse(normalized.mnemonic, normalized.args, InstructionMeta.missing())
+                self.assertEqual(parsed.inputs, [])
+                self.assertEqual(parsed.outputs, [Register(f'cr{field}_{bit}')])
+
+    def test_constant_idioms_do_not_read_unset_bits(self):
+        for mnemonic, value in [('crxor', 0), ('crandc', 0), ('creqv', 1), ('crorc', 1)]:
+            instruction = self.parse(mnemonic, 30, 9, 9)
+            self.assertEqual(instruction.inputs, [])
+            results = {}
+            instruction.eval_fn(SimpleNamespace(set_reg=lambda reg, expr: results.update({reg: expr})), None)
+            self.assertEqual(evaluate(results[Register('cr7_eq')]), value)
+
+    def test_alias_read_write_sets(self):
+        self.assertEqual(self.parse('crmove', 30, 9).inputs, [Register('cr2_gt')])
+        self.assertEqual(self.parse('crnot', 30, 9).inputs, [Register('cr2_gt')])
+        self.assertEqual(self.parse('crset', 30).inputs, [])
+        self.assertEqual(self.parse('crclr', 30).outputs, [Register('cr7_eq')])
+
+    def test_invalid_indices_and_arity_are_rejected(self):
+        for operands in [(-1, 0, 2), (32, 1, 2), (2, 1), (2, 1, 32)]:
+            with self.assertRaises(DecompFailure):
+                self.parse('cror', *operands)
+
+    def test_ordered_union_and_negation_preserve_nan(self):
+        for a in (-math.inf, -1.0, 0.0, 1.0, math.inf, math.nan):
+            for b in (-math.inf, 0.0, math.inf, math.nan):
+                left, right = Literal(a, type=Type.f32()), Literal(b, type=Type.f32())
+                for op, combined in [('<', '<='), ('>', '>=')]:
+                    relation = BinaryOp(left, op, right, type=Type.boolean())
+                    equality = BinaryOp(left, '==', right, type=Type.boolean())
+                    for x, y in [(relation, equality), (equality, relation)]:
+                        result = cr_logical('cror', x, y)
+                        self.assertEqual(result.op, combined)
+                        self.assertEqual(evaluate(result), evaluate(relation) or evaluate(equality))
+                        self.assertEqual(evaluate(result.negated()), not evaluate(result))
+
+    def test_different_operands_are_not_merged(self):
+        x, y, z = Literal(1), Literal(2), Literal(3)
+        a = BinaryOp(x, '>', y, type=Type.boolean())
+        b = BinaryOp(x, '==', z, type=Type.boolean())
+        self.assertEqual(cr_logical('cror', a, b).op, '||')
+
+    def test_floating_unordered_bit_is_not_constant_zero(self):
+        for mnemonic in ('fcmpo', 'fcmpu'):
+            for x, y in [(1.0, 2.0), (math.inf, math.inf), (math.nan, 2.0), (1.0, math.nan)]:
+                args = [Register('cr3'), Register('f1'), Register('f2')]
+                instruction = PpcArch.parse(mnemonic, args, InstructionMeta.missing())
+                values = {1: Literal(x, type=Type.f32()), 2: Literal(y, type=Type.f32())}
+                result = {}
+                instruction.eval_fn(SimpleNamespace(set_reg=lambda reg, expr: result.update({reg: expr})),
+                                    SimpleNamespace(reg=lambda index: values[index]))
+                self.assertEqual(bool(evaluate(result[Register('cr3_so')])), math.isnan(x) or math.isnan(y))
+
+    def test_overwriting_destination_does_not_change_source_values(self):
+        instruction = self.parse('cror', 2, 1, 2)
+        regs = {Register('cr0_gt'): Literal(1), Register('cr0_eq'): Literal(0)}
+        instruction.eval_fn(SimpleNamespace(set_reg=lambda reg, expr: regs.update({reg: expr})),
+                            SimpleNamespace(regs=regs))
+        self.assertTrue(evaluate(regs[Register('cr0_eq')]))
+        self.assertEqual(evaluate(regs[Register('cr0_gt')]), 1)
+
+
+if __name__ == '__main__':
+    unittest.main()
